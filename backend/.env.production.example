# ─────────────────────────────────────────────────────────────
# RankOS Backend — PRODUCTION environment template
# Copy to `.env` (or set these in your host's env/secret manager).
# Values marked (required) MUST be set or the server refuses to boot.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production                       # (required) enables prod guards
PORT=8080
API_PREFIX=/api
APP_NAME=RankOS API

# ── MongoDB (required) — use a managed cluster (Atlas), NOT localhost ─
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rankos

# ── Frontend origin ──────────────────────────────────────────
# Exact URL of the deployed frontend (used for OAuth/email redirects).
CLIENT_URL=https://app.yourdomain.com

# ── CORS ─────────────────────────────────────────────────────
# EXACT origin(s), comma-separated. NEVER use "*" with credentials.
CORS_ORIGIN=https://app.yourdomain.com
CORS_CREDENTIALS=true

# ── Auth / JWT (required in production) ───────────────────────
# Generate strong, unique values:  openssl rand -base64 48
# The server EXITS if these are missing or still contain the dev defaults.
JWT_ACCESS_SECRET=__REPLACE_WITH_openssl_rand_base64_48__
JWT_REFRESH_SECRET=__REPLACE_WITH_A_DIFFERENT_openssl_rand_base64_48__
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=12

# ── Auth cookies ─────────────────────────────────────────────
COOKIE_SECURE=true                        # (required for HTTPS) always true in prod
# If the frontend and API are on DIFFERENT domains, the session cookie is
# cross-site and needs SameSite=None + Secure:
COOKIE_SAME_SITE=none                      # use "lax" ONLY if API is same-origin as the app
# If they share a parent domain, you may set:
# COOKIE_DOMAIN=.yourdomain.com

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs                               # falls back to console-only if unwritable

# ── Swagger ──────────────────────────────────────────────────
SWAGGER_ENABLED=false                      # usually disabled in production

# ── Optional integrations (features degrade gracefully if unset) ─
# Redis (rate-limit sharing, queues):
# REDIS_URL=redis://<host>:6379
# Cloudinary (real file storage instead of local disk):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# SMTP (real password-reset emails):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="RankOS <no-reply@yourdomain.com>"
# AI provider (real LLM instead of grounded fallback):
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=
# Google OAuth (real "Continue with Google"):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMS/OTP (Twilio) + Google Vision OCR:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/vision-sa.json
