# ─────────────────────────────────────────────────────────────
# RankOS Backend — Environment Variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# Variables marked (required) must be present or the server exits.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=development                 # development | production | test
PORT=8080
API_PREFIX=/api                      # base path for all routes
APP_NAME=RankOS API

# ── MongoDB (required) ───────────────────────────────────────
# Local:  mongodb://localhost:27017/rankos
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rankos
MONGODB_URI=mongodb://localhost:27017/rankos

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for all (dev only).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# ── Auth / JWT ───────────────────────────────────────────────
# JWT secrets are (required) in production — the server exits without them.
# Generate strong values, e.g.  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m                # access token lifetime
JWT_REFRESH_EXPIRES=7d                # refresh token lifetime
JWT_ISSUER=rankos.api
JWT_AUDIENCE=rankos.client
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFY_EXPIRES=24h              # email verification link lifetime
PASSWORD_RESET_EXPIRES=30m           # password reset link lifetime

# ── Auth cookies ─────────────────────────────────────────────
# URL of the frontend (used for OAuth redirects and email links).
CLIENT_URL=http://localhost:5173
# COOKIE_DOMAIN=                      # leave blank for host-only cookies
COOKIE_SECURE=false                  # true in production (HTTPS)
COOKIE_SAME_SITE=lax                 # lax | strict | none (none requires secure)

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes
RATE_LIMIT_MAX=300                   # max requests per window per IP

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info                       # error | warn | info | http | debug
LOG_DIR=logs

# ── Redis (optional — used by BullMQ & caching) ──────────────
# Provide REDIS_URL, or the discrete host/port/password fields.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Cloudinary (optional — media uploads) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP / Nodemailer (optional — transactional email) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="RankOS <no-reply@rankos.app>"

# ── SMS / OTP provider (optional — dev-stub logs the code) ───
# Without these, signup/login OTP codes are written to the server log instead of
# being sent over SMS, so auth works locally with zero setup. Provide Twilio
# credentials to send real messages.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ── Google OAuth (optional — "Continue with Google") ─────────
# Without these, /auth/oauth/google uses a dev stub that signs in a demo user.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Google Vision OCR (optional — dev-stub parses a sample) ──
# Point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON file, OR paste
# the JSON directly into GOOGLE_VISION_KEY_JSON. Without either, uploads are
# OCR'd by a stub that returns a sample exam sheet so the pipeline runs.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_VISION_KEY_JSON=

# ── AI provider (optional — grounded local fallback when unset) ─
# The AI layer (mentor, recommendations, notes, summary, roadmap) auto-selects
# the first configured provider; with none set it uses a data-grounded local
# fallback (never a dummy response). Force one with AI_PROVIDER and override the
# model with AI_MODEL. Switching providers is an env change only.
# AI_PROVIDER=anthropic          # anthropic | gemini | openai | local
# AI_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ── Swagger ──────────────────────────────────────────────────
SWAGGER_ENABLED=true
