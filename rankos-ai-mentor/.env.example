# Base URL of the RankOS REST API.
# - Leave unset in production when the API is served same-origin behind a proxy
#   at `/api` (the default the client falls back to).
# - Set to an absolute URL to target a separate API host, e.g. the backend/ service:
#     VITE_API_URL=http://localhost:8080/api
# In local dev the Vite proxy already forwards `/api` -> http://localhost:8080,
# so you normally don't need to set this.
# VITE_API_URL=http://localhost:8080/api
